{
  "name": "pi-runs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The run tool: one scout-agent per run on its own branch and worktree, launched through pi-subagents, with a durable record.",
  "license": "MIT",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --import ../../packages/coding-agent/src/experimental/source-resolver.ts --test runs.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension"
  ]
}
