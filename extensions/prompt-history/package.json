{
  "name": "@light4/pi-prompt-history",
  "version": "0.3.6",
  "description": "Fuzzy prompt history for Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompt-history"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/light4/pi-prompt-history.git"
  },
  "files": [
    "src"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --import ../../packages/coding-agent/src/experimental/source-resolver.ts --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "private": true
}
