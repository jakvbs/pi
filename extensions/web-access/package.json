{
  "name": "pi-web-access",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web search (OpenAI hosted search, Exa), page, PDF and GitHub repository fetching, and stored-result retrieval for pi.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --import ../../packages/coding-agent/src/experimental/source-resolver.ts --test *.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.16.11",
    "turndown": "7.2.4",
    "unpdf": "1.9.0"
  },
  "devDependencies": {
    "@types/turndown": "5.0.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
